# Tiger inner model-required profile only; this template is not loaded automatically.
# Put actual credentials in a protected operator-owned file outside the checkout,
# then export these four variables in the trusted CLI/MCP startup environment.
# Official alias mapping observed 2026-10-26: DeepSeek-V4.1-Flash-1017.
# deepseek-flash is an alias, not an immutable versioned model identifier.
LLM_BACKEND=api
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
# Search uses the same provider/key at /v1/tools/search. Fetch is supported by
# the adapter at /v1/tools/fetch but is not invoked by the fixed 14-topic collector.
# No local/mock/disabled/passthrough or alternate-model fallback is allowed.

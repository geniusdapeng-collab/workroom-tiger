{
  "schemaVersion": "workloom.agent-capabilities/v1",
  "bundleId": "trading",
  "capabilities": [
    {
      "id": "trading.repo.status",
      "version": "1.0.0",
      "title": "读取本仓自述",
      "description": "读取本仓 product.manifest 摘要与 bundles/docs/脚本计数；只读，不访问服务端。",
      "operation": "read",
      "risk": "low",
      "dataMode": "unverified",
      "transport": {
        "kind": "local",
        "module": "bundles/trading/capabilities/repo.mjs",
        "export": "repoStatus"
      },
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "id": "trading.repo.docs",
      "version": "1.0.0",
      "title": "读取文档索引",
      "description": "列出 docs/*.md 与一级标题（最多 60 条），供 Agent 找 runbook 与规范；只读。",
      "operation": "read",
      "risk": "low",
      "dataMode": "unverified",
      "transport": {
        "kind": "local",
        "module": "bundles/trading/capabilities/repo.mjs",
        "export": "repoDocs"
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          }
        },
        "additionalProperties": false
      }
    },
    {
      "id": "trading.bundle.summary",
      "version": "1.0.0",
      "title": "读取行业包概览",
      "description": "读取 governance/bundles/trading 的 skills/fences/pipelines/presets/library 计数与围栏规则样例；只读。",
      "operation": "read",
      "risk": "low",
      "dataMode": "unverified",
      "transport": {
        "kind": "local",
        "module": "bundles/trading/capabilities/repo.mjs",
        "export": "bundleSummary"
      },
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "id": "trading.repo.readiness",
      "version": "1.0.0",
      "title": "检查接入就绪度（不执行）",
      "description": "检查 Python 引擎与 governance 治理壳的实际布局、Node 版本和 MCP 入口；不读取用户密钥，不启动 Python，不联网。",
      "operation": "preview",
      "risk": "low",
      "dataMode": "unverified",
      "transport": {
        "kind": "local",
        "module": "bundles/trading/capabilities/repo.mjs",
        "export": "repoReadiness"
      },
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  ]
}

{
  "schemaVersion": "workloom.product/v1",
  "productId": "workroom-tiger",
  "role": "industry",
  "displayName": "老虎全球资产管理系统",
  "packageName": "workloom-im",
  "repository": "workloom-ai/workroom-tiger",
  "defaultBundle": "trading",
  "demoWorkspaceSlug": "tiger-trading",
  "demoMemberNo": "MEM-T001",
  "release": {
    "appId": "com.geniusdapeng.workroomtiger",
    "channel": "stable",
    "artifactPrefix": "Workroom.Tiger",
    "workflow": ".cnb.yml",
    "website": "apps/site"
  },
  "desktop": {
    "portOffset": 610,
    "industryPacker": "scripts/pack-tiger-kernel.mjs",
    "nativeBuilders": {
      "mac": "scripts/build-tiger-desktop-native.sh",
      "win": "scripts/build-tiger-desktop-native.ps1"
    },
    "smokeRunner": "scripts/tiger-desktop-smoke.mjs"
  },
  "clients": {
    "bPc": { "enabled": true, "entry": "apps/web" },
    "bMobile": { "enabled": true, "entry": "apps/webb" },
    "cMobile": { "enabled": true, "entry": "apps/webc" }
  }
}

[Unit]
Description=Tiger PnL verified immutable ledger backup
After=tiger-pnl.service

[Service]
Type=oneshot
User=tiger-pnl
Group=tiger-pnl
WorkingDirectory=/opt/tiger-pnl/current
ExecStart=/opt/tiger-pnl/current/pnl/deploy/backup.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/tiger-pnl
ReadWritePaths=/var/backups/tiger-pnl
MemoryMax=192M
